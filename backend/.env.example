# ==========================================
# FIREBASE CONFIGURATION
# ==========================================

# Your Firebase Project ID. 
# You can find this in the Firebase Console -> Project Settings -> General.
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Firebase Service Account Credentials as a compact JSON string.
# To get this: 
# 1. Go to Firebase Console -> Project Settings -> Service Accounts
# 2. Click "Generate new private key"
# 3. Minify the downloaded JSON file into a single line string to use here.
# (If using a file locally instead for `FIREBASE_CREDENTIALS_PATH`, you can leave this blank).
FIREBASE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Allowed CORS origins, formatted as a comma-separated list.
# For local frontend development (e.g. React/Vite/Next.js) use origins like http://localhost:3000
# In production, set this strictly to your deployed frontend domain.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# The file path or database URL for the local SQLite offline sync queue.
# By default, a local file named `sync_queue.db` will be created in the root directory.
SQLITE_DB_PATH="sync_queue.db"
